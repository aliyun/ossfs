+// Signature headers that must be refreshed when re-signing a retried request.
+static const std::string_view kSignatureHeaders[] = {
+    "Authorization", "x-oss-security-token", "x-oss-date",
+    "x-oss-content-sha256", "Date"};
+
+// HeadersBase has no per-key erase; rebuild the header block without the
+// stale signature headers so a fresh sign() can insert updated values.
+// Host must be re-inserted first: reset_host() locates it by physical
+// offset 0 alone, while iteration order is sorted by header name.
+static int strip_signature_headers(photon::net::http::Headers& headers) {
+  std::vector<std::pair<std::string, std::string>> keep;
+  std::pair<std::string, std::string> host;
+  for (auto kv : headers) {
+    bool is_sig = false;
+    for (auto k : kSignatureHeaders) {
+      if (kv.first.size() == k.size() &&
+          strncasecmp(kv.first.data(), k.data(), k.size()) == 0) {
+        is_sig = true;
+        break;
+      }
+    }
+    if (is_sig) continue;
+    if (kv.first.size() == 4 &&
+        strncasecmp(kv.first.data(), "Host", 4) == 0) {
+      host.first = kv.first;
+      host.second = kv.second;
+      continue;
+    }
+    keep.emplace_back(kv.first, kv.second);
+  }
+  headers.reset();
+  if (!host.first.empty() && headers.insert(host.first, host.second) < 0)
+    LOG_ERROR_RETURN(0, -1, "failed to rebuild Host header");
+  for (auto& kv : keep)
+    if (headers.insert(kv.first, kv.second) < 0)
+      LOG_ERROR_RETURN(0, -1, "failed to rebuild header `", kv.first);
+  return 0;
+}
